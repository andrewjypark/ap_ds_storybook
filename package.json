{
  "name": "ap-ds-storybook",
  "version": "1.0.0",
  "type": "module",
  "description": "This example code is bare-bones to show you what this framework can do. If you have the style-dictionary module installed globally, you can `cd` into this directory and run: ```bash style-dictionary build ```",
  "main": "build-tokens.js",
  "scripts": {
    "build": "node build-tokens.js && node scripts/generate-color-manifest.js && node scripts/generate-border-manifest.js && node scripts/generate-typography-manifest.js",
    "storybook": "npm run build && storybook dev -p 6006",
    "build-storybook": "npm run build && storybook build",
    "deploy-storybook": "npx gh-pages -d storybook-static -b gh-pages",
    "serve-storybook": "http-server storybook-static --port 6006 --silent",
    "test-storybook": "test-storybook --url http://localhost:6006",
    "test-storybook:ci": "concurrently -k -s first -n \"SB,TEST\" \"npm run serve-storybook\" \"wait-on tcp:6006 && npm run test-storybook\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewjypark/ap_ds_storybook.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/andrewjypark/ap_ds_storybook/issues"
  },
  "homepage": "https://github.com/andrewjypark/ap_ds_storybook#readme",
  "dependencies": {
    "@tokens-studio/sd-transforms": "^2.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@storybook/test-runner": "^0.26.0",
    "axe-playwright": "^2.2.2",
    "concurrently": "^10.0.6",
    "gh-pages": "^6.3.0",
    "http-server": "^14.1.1",
    "storybook": "^10.3.6",
    "style-dictionary": "^5.4.0",
    "vite": "^6.0.0",
    "wait-on": "^9.5.1"
  }
}
